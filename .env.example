# Every setting the API reads (OPS-02). Any setting can instead be read from a file, by
# setting <NAME>_FILE to the file's path.

# Where the API runs.
# Type: development, test or production. Required, no default.
ENVIRONMENT=development

# The address the HTTP server binds.
# Type: socket address. Required, no default.
LISTEN_ADDR=127.0.0.1:8080
