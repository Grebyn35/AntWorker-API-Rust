# Every setting the API reads (OPS-02), and the one setting Compose reads. Any setting the API
# reads can instead come from a file, by setting <NAME>_FILE to the file's path.
# `just setup` writes .env from this file, replacing each __..._PASSWORD__ placeholder with a
# generated password.

# Where the API runs.
# Type: development, test or production. Required by every subcommand that logs: bootstrap,
# migrate and serve. No default.
ENVIRONMENT=development

# The most detailed level logged. Never coarser than info, because every request writes its
# completion line at info (PLATFORM-044).
# Type: info, debug or trace. Optional, default info.
LOG_LEVEL=info

# Where every subcommand that logs exports its spans, log records and metrics over OTLP/HTTP, such
# as the collector's http://127.0.0.1:4318. Unset, nothing is exported, and the logs still go to
# stdout. `just dev` sets it when it starts the observability stack.
# The variables of OpenTelemetry's SDK and OTLP exporter that would change what the API exports
# must be unset, even to an empty value: OTEL_SERVICE_NAME, OTEL_RESOURCE_ATTRIBUTES,
# OTEL_TRACES_SAMPLER, OTEL_TRACES_SAMPLER_ARG, OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT,
# OTEL_SPAN_EVENT_COUNT_LIMIT, OTEL_SPAN_LINK_COUNT_LIMIT, OTEL_BSP_SCHEDULE_DELAY,
# OTEL_BSP_EXPORT_TIMEOUT, OTEL_BSP_MAX_QUEUE_SIZE, OTEL_BSP_MAX_EXPORT_BATCH_SIZE,
# OTEL_BSP_MAX_CONCURRENT_EXPORTS, OTEL_BLRP_SCHEDULE_DELAY, OTEL_BLRP_EXPORT_TIMEOUT,
# OTEL_BLRP_MAX_QUEUE_SIZE, OTEL_BLRP_MAX_EXPORT_BATCH_SIZE, OTEL_METRIC_EXPORT_INTERVAL,
# OTEL_METRIC_EXPORT_TIMEOUT, OTEL_EXPORTER_OTLP_HEADERS, OTEL_EXPORTER_OTLP_TIMEOUT,
# OTEL_EXPORTER_OTLP_PROTOCOL, OTEL_EXPORTER_OTLP_COMPRESSION, OTEL_EXPORTER_OTLP_INSECURE,
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT, OTEL_EXPORTER_OTLP_TRACES_HEADERS,
# OTEL_EXPORTER_OTLP_TRACES_TIMEOUT, OTEL_EXPORTER_OTLP_TRACES_PROTOCOL,
# OTEL_EXPORTER_OTLP_TRACES_COMPRESSION, OTEL_EXPORTER_OTLP_TRACES_INSECURE,
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT, OTEL_EXPORTER_OTLP_LOGS_HEADERS,
# OTEL_EXPORTER_OTLP_LOGS_TIMEOUT, OTEL_EXPORTER_OTLP_LOGS_PROTOCOL,
# OTEL_EXPORTER_OTLP_LOGS_COMPRESSION, OTEL_EXPORTER_OTLP_LOGS_INSECURE,
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT, OTEL_EXPORTER_OTLP_METRICS_HEADERS,
# OTEL_EXPORTER_OTLP_METRICS_TIMEOUT, OTEL_EXPORTER_OTLP_METRICS_PROTOCOL,
# OTEL_EXPORTER_OTLP_METRICS_COMPRESSION, OTEL_EXPORTER_OTLP_METRICS_INSECURE and
# OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE.
# Type: http or https URL with a host, and no user, password, query or fragment. Optional, no
# default.
OTEL_EXPORTER_OTLP_ENDPOINT=

# The address the HTTP server binds, and that health asks.
# Type: socket address. Required by serve and health, no default.
LISTEN_ADDR=127.0.0.1:8080

# The most requests the API serves at once, health probes aside. A request beyond it gets the 503
# problem request.overloaded (OPS-07). The load test measures what an instance can take (OPS-16).
# Type: whole number from 1 to 100000. Optional, default 100.
MAX_CONCURRENT_REQUESTS=100

# How long serve keeps serving after a shutdown signal while readiness answers draining, so the
# load balancer stops sending it requests (OPS-06). At least the load balancer's health-check
# interval.
# Type: whole number of seconds from 0 to 300. Optional, default 5.
SHUTDOWN_DELAY_SECONDS=0

# How long serve waits for the requests in flight once it stops accepting connections (OPS-06):
# at least the longest timeout of a route, so a deploy cuts none short.
# The longest is an upload's, 60 seconds. # part: files
# The container's grace period must exceed it plus SHUTDOWN_DELAY_SECONDS, plus the time that
# writing out telemetry may take, which the platform spec's Telemetry export states.
# Type: whole number of seconds from 60 to 300. Optional, default 60.
SHUTDOWN_DRAIN_SECONDS=60

# The key of every keyed hash, such as a rate limit's bucket key, so the database holds no IP
# address or email that the limits count (SEC-03, PLATFORM-057). Changing it starts every bucket
# afresh, and ends every device token (AUTH-019). `just setup` generates one.
# It also signs signed URLs, so changing it ends every one (PLATFORM-080). # part: files
# Type: base64 of at least 32 random bytes, a secret. Required by serve, no default.
HMAC_KEY=__HMAC_KEY__

# The proxies in front of the API whose X-Forwarded-For names the client, such as the reference
# deployment's Caddy and a content delivery network in front of it (PLATFORM-053). From any other
# peer, the peer is the client.
# Type: IP addresses and ranges separated by commas or spaces, such as 172.18.0.0/16,
# 203.0.113.7. Optional, default none.
TRUSTED_PROXIES=

# The origins of web clients, which may read the API's responses and send its cookies
# (PLATFORM-058). A web client is served from the API's own site, such as app.example.com beside
# api.example.com, since its cookies are SameSite=Strict (AUTH-015). In development, the API's own
# address, by either name, is one: the API reference that it serves at /docs sends its requests
# from there (PLATFORM-052).
# Type: origins separated by commas, such as https://app.example.com, each https, or http on a
# loopback host in development, with no path. Optional, default none: no browser may call the
# API.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# How many requests one client IP may send in each window, health probes aside, before 429
# (PLATFORM-054). Every authenticated request counts in its user's bucket too.
# Public downloads, of files and avatars, count in RATE_LIMIT_PUBLIC_REQUESTS instead. # part: files
# Type: whole number from 1 to 1000000. Optional, default 600.
RATE_LIMIT_IP_REQUESTS=600

# part: files
# How many requests under /v1/public/, public downloads of files and avatars, one client IP may send in each
# window, before 429, apart from the requests that RATE_LIMIT_IP_REQUESTS counts, so a page that
# shows many public images uses up neither the other (PLATFORM-082, FILES-023, FILES-024).
# Type: whole number from 1 to 1000000. Optional, default 1200.
RATE_LIMIT_PUBLIC_REQUESTS=1200
# end part: files

# How many requests one user may send in each window, before 429 (PLATFORM-054).
# Type: whole number from 1 to 1000000. Optional, default 300.
RATE_LIMIT_USER_REQUESTS=300

# The length of the IP and user limits' windows (PLATFORM-055).
# Type: whole number of seconds from 1 to 86400. Optional, default 60.
RATE_LIMIT_WINDOW_SECONDS=60

# How long an access token lasts, at most REFRESH_TOKEN_SECONDS, which startup refuses otherwise
# (AUTH-007).
# Type: whole number of seconds from 60 to 86400. Optional, default 3600.
ACCESS_TOKEN_SECONDS=3600

# How long a refresh token lasts, sliding with each refresh (AUTH-007, AUTH-010).
# Type: whole number of seconds from 3600 to 31536000. Optional, default 2592000, 30 days.
REFRESH_TOKEN_SECONDS=2592000

# How long a session lasts at most, whatever its refreshes (AUTH-007).
# Type: whole number of seconds from 3600 to 31536000. Optional, default 7776000, 90 days.
SESSION_LIFETIME_SECONDS=7776000

# How many sign-in attempts each email allows from each client address in each window, before
# 429, and with each device token valid for it (AUTH-006).
# Type: whole number from 1 to 1000. Optional, default 5.
SIGN_IN_ATTEMPTS=5

# How many sign-in attempts each email allows from every address together in each window, before
# 429, counting only those that SIGN_IN_ATTEMPTS lets through (AUTH-006).
# Type: whole number from 1 to 100000. Optional, default 50.
SIGN_IN_EMAIL_ATTEMPTS=50

# The length of the sign-in limits' window (AUTH-006).
# Type: whole number of seconds from 1 to 86400. Optional, default 900, 15 minutes.
SIGN_IN_WINDOW_SECONDS=900

# How long a device token lasts, which a registration or a sign-in issues, so that the device's
# next sign-in counts only in its own limit (AUTH-019).
# Type: whole number of seconds from 86400 to 157680000. Optional, default 31536000, 365 days.
DEVICE_TOKEN_SECONDS=31536000

# Whether the API sends email: smtp sends it through the server the SMTP_ settings name, and every
# account proves its address with a code sent to it before the API serves it anything else
# (AUTH-025); off sends none, so nothing proves an address or resets a password (PLATFORM-022,
# D67). With off, no other email setting is read. Here every email goes to the Mailpit that `just services` starts,
# whose page at http://127.0.0.1:8025 shows it, and nothing leaves the machine (PLATFORM-023).
# Type: smtp or off. Required by serve, no default.
EMAIL=smtp

# The mail server's host name or IP address.
# Type: host name or IP address. Required by serve with EMAIL=smtp, no default.
SMTP_HOST=127.0.0.1

# How the connection to the mail server is encrypted: tls starts with TLS, starttls upgrades to
# it before anything else is sent, and refuses a server that can't, and none doesn't encrypt,
# for a mail server on the same machine, such as Mailpit, which `just services` starts, since
# every connection that leaves the server uses TLS (OPS-17), and takes no credentials.
# Type: tls, starttls or none. Optional, default starttls.
SMTP_SECURITY=none

# The mail server's port.
# Type: whole number from 1 to 65535. Optional, default 465 with tls, 587 with starttls, 25
# with none.
SMTP_PORT=1025

# The user name the mail server signs the API in with, given with SMTP_PASSWORD or not at all
# (PLATFORM-024).
# Type: text. Optional, default none.
SMTP_USERNAME=

# The mail server's password for SMTP_USERNAME (PLATFORM-024).
# Type: text, a secret. Optional, default none.
SMTP_PASSWORD=

# The sender of every email, as a name and an address (PLATFORM-025).
# Type: name and email address, such as AntWorker <noreply@example.com>, in quotes since it holds
# a space. Required by serve with EMAIL=smtp, no default.
EMAIL_FROM="AntWorker <noreply@example.com>"

# part: files
# The endpoint of the S3-compatible bucket that holds files' bytes (PLATFORM-076). Here it is the
# SeaweedFS that `just services` starts, which asks for no credentials, so the keys below reach it
# whatever they hold.
# Type: https URL with a host and no path, or http in development and test. Required by serve, no
# default.
S3_ENDPOINT=http://127.0.0.1:8333

# The bucket's region (PLATFORM-076).
# Type: text. Required by serve, no default.
S3_REGION=us-east-1

# The bucket's name (PLATFORM-076).
# Type: text. Required by serve, no default.
S3_BUCKET=files

# Whether the bucket's name goes in the endpoint's host, as most providers take it, or in the
# path, for a provider whose bucket names don't appear in its host names, such as SeaweedFS
# (PLATFORM-076).
# Type: host or path. Optional, default host.
S3_URI_STYLE=path

# The path of a PEM file of certificates that the bucket's certificate may chain to, beside the
# operating system's, such as a private authority's, for a bucket of the operator's own
# (PLATFORM-076).
# Type: path of a file. Optional, default none.
S3_CA_PATH=

# The ID of a key pair that reaches only the bucket (PLATFORM-076).
# Type: text. Required by serve, no default.
S3_ACCESS_KEY_ID=development

# The secret of that key pair (PLATFORM-076).
# Type: text, a secret. Required by serve, no default.
S3_SECRET_ACCESS_KEY=development

# The malware scanner, ClamAV's daemon, as a host and a port, which scans every upload's bytes
# before they are stored (PLATFORM-079, FILES-005). `just services` runs it with one signature,
# which names the EICAR test file. clamd speaks no TLS, so it runs on the API's private network.
# Type: host and port, such as scanner:3310. Required by serve, no default.
CLAMD_ADDRESS=127.0.0.1:3310

# The most bytes an upload holds (FILES-004). A replica holds at most 4 uploads in memory at once
# (PLATFORM-074), so give each replica 4 times this beside what it needs otherwise.
# Type: whole number from 1 to 20971520. Optional, default 10485760, 10 MiB.
FILE_MAX_BYTES=10485760

# How many days the bytes of an object that no file's row names stay, so that a restore of the
# database to any moment it reaches finds the bytes of every file it brings back: the backups'
# reach, BACKUP_RETENTION_DAYS plus 7 with the bundled database, or a managed database's recovery
# window (FILES-011). Its largest value is the largest BACKUP_RETENTION_DAYS, 3650, plus 7.
# Type: whole number of days from 1 to 3657. Optional, default 35.
FILE_DELETION_DELAY_DAYS=35
# end part: files

# part: invitations
# How many days an invitation lasts (INVITATIONS-001).
# Type: whole number from 1 to 90. Optional, default 7.
INVITATION_EXPIRY_DAYS=7

# How many times each member may invite in each window, before 429, which bounds the emails
# their invitations send (INVITATIONS-009).
# Type: whole number from 1 to 100000. Optional, default 100.
INVITATION_LIMIT=100

# The length of the invitation limit's window (INVITATIONS-009).
# Type: whole number of seconds from 1 to 86400. Optional, default 3600, an hour.
INVITATION_WINDOW_SECONDS=3600
# end part: invitations

# How long a dead-lettered job keeps its payload, for investigating it, before the hourly sweep
# deletes it (PLATFORM-014).
# Type: whole number of days from 1 to 365. Optional, default 14.
JOB_DEAD_LETTER_RETENTION_DAYS=14

# How often each event stream sends a comment, so proxies in front of the API don't close it
# while no event comes (REALTIME-003). Shorter than the idle timeout of every proxy in front.
# Type: whole number of seconds from 5 to 300. Optional, default 15.
STREAM_HEARTBEAT_SECONDS=15

# How often the hub re-checks each open stream's session and memberships, the longest a stream
# outlives its session, or an access change whose signal it missed (PLATFORM-031, SEC-06).
# Type: whole number of seconds from 10 to 3600. Optional, default 60.
STREAM_RECHECK_SECONDS=60

# The connection the API serves with, as the role app (DATA-12). bootstrap sets the app role's
# password from it, and the sqlx query macros check queries against it while compiling.
# Type: PostgreSQL URL with a user, a password, a host and a database, and a port unless it is
# 5432. Its only allowed query parameters are sslmode, sslrootcert, sslcert, sslkey and
# application_name. The libpq variables PGPORT, PGSSLMODE, PGSSLROOTCERT, PGSSLCERT, PGSSLKEY,
# PGAPPNAME and PGOPTIONS must be unset, even to an empty value. Required by serve and
# bootstrap, no default.
DATABASE_URL=postgres://app:__APP_PASSWORD__@127.0.0.1:5432/api

# The most connections the API's pool opens.
# Type: whole number from 1 to 1000. Optional, default 10.
DATABASE_MAX_CONNECTIONS=10

# The connection migrate runs on, as the role owner (DATA-12). bootstrap sets the owner role's
# password from it.
# Type: PostgreSQL URL, as for DATABASE_URL. Required by migrate and bootstrap, no default.
DATABASE_OWNER_URL=postgres://owner:__OWNER_PASSWORD__@127.0.0.1:5432/api

# An administrator's connection to the database, which bootstrap uses to create the roles.
# Type: PostgreSQL URL, as for DATABASE_URL. Required by bootstrap, no default.
DATABASE_ADMIN_URL=postgres://postgres:__ADMIN_PASSWORD__@127.0.0.1:5432/api

# The administrator password of the Postgres that Compose runs. Read by Compose, not by the API.
# Type: password, the same as the one in DATABASE_ADMIN_URL. Required by Compose, no default.
POSTGRES_PASSWORD=__ADMIN_PASSWORD__
