# Every setting the API reads (OPS-02), and the one setting Compose reads. Any setting the API
# reads can instead come from a file, by setting <NAME>_FILE to the file's path.
# `just setup` writes .env from this file, replacing each __..._PASSWORD__ placeholder with a
# generated password.

# Where the API runs.
# Type: development, test or production. Required by every subcommand, no default.
ENVIRONMENT=development

# The most detailed level logged. Never coarser than info, because every request writes its
# completion line at info (PLATFORM-034).
# Type: info, debug or trace. Optional, default info.
LOG_LEVEL=info

# Where every subcommand that logs exports its spans, log records and metrics over OTLP/HTTP, such
# as the collector's http://127.0.0.1:4318. Unset, nothing is exported, and the logs still go to
# stdout. `just dev` sets it when it starts the observability stack.
# The variables of OpenTelemetry's SDK and OTLP exporter that would change what the API exports
# must be unset, even to an empty value: OTEL_SERVICE_NAME, OTEL_RESOURCE_ATTRIBUTES,
# OTEL_TRACES_SAMPLER, OTEL_TRACES_SAMPLER_ARG, OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT,
# OTEL_SPAN_EVENT_COUNT_LIMIT, OTEL_SPAN_LINK_COUNT_LIMIT, OTEL_BSP_SCHEDULE_DELAY,
# OTEL_BSP_EXPORT_TIMEOUT, OTEL_BSP_MAX_QUEUE_SIZE, OTEL_BSP_MAX_EXPORT_BATCH_SIZE,
# OTEL_BSP_MAX_CONCURRENT_EXPORTS, OTEL_BLRP_SCHEDULE_DELAY, OTEL_BLRP_EXPORT_TIMEOUT,
# OTEL_BLRP_MAX_QUEUE_SIZE, OTEL_BLRP_MAX_EXPORT_BATCH_SIZE, OTEL_METRIC_EXPORT_INTERVAL,
# OTEL_METRIC_EXPORT_TIMEOUT, OTEL_EXPORTER_OTLP_HEADERS, OTEL_EXPORTER_OTLP_TIMEOUT,
# OTEL_EXPORTER_OTLP_PROTOCOL, OTEL_EXPORTER_OTLP_COMPRESSION, OTEL_EXPORTER_OTLP_INSECURE,
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT, OTEL_EXPORTER_OTLP_TRACES_HEADERS,
# OTEL_EXPORTER_OTLP_TRACES_TIMEOUT, OTEL_EXPORTER_OTLP_TRACES_PROTOCOL,
# OTEL_EXPORTER_OTLP_TRACES_COMPRESSION, OTEL_EXPORTER_OTLP_TRACES_INSECURE,
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT, OTEL_EXPORTER_OTLP_LOGS_HEADERS,
# OTEL_EXPORTER_OTLP_LOGS_TIMEOUT, OTEL_EXPORTER_OTLP_LOGS_PROTOCOL,
# OTEL_EXPORTER_OTLP_LOGS_COMPRESSION, OTEL_EXPORTER_OTLP_LOGS_INSECURE,
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT, OTEL_EXPORTER_OTLP_METRICS_HEADERS,
# OTEL_EXPORTER_OTLP_METRICS_TIMEOUT, OTEL_EXPORTER_OTLP_METRICS_PROTOCOL,
# OTEL_EXPORTER_OTLP_METRICS_COMPRESSION, OTEL_EXPORTER_OTLP_METRICS_INSECURE and
# OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE.
# Type: http or https URL with a host, and no user, password, query or fragment. Optional, no
# default.
OTEL_EXPORTER_OTLP_ENDPOINT=

# The address the HTTP server binds.
# Type: socket address. Required by serve, no default.
LISTEN_ADDR=127.0.0.1:8080

# The most requests the API serves at once, health probes aside. A request beyond it gets the 503
# problem request.overloaded (OPS-07). The load test measures what an instance can take (OPS-18).
# Type: whole number from 1 to 100000. Optional, default 100.
MAX_CONCURRENT_REQUESTS=100

# How long serve keeps serving after a shutdown signal while readiness answers draining, so the
# load balancer stops sending it requests (OPS-06). At least the load balancer's health-check
# interval.
# Type: whole number of seconds from 0 to 300. Optional, default 5.
SHUTDOWN_DELAY_SECONDS=0

# How long serve waits for the requests in flight once it stops accepting connections (OPS-06).
# The container's grace period must exceed it plus SHUTDOWN_DELAY_SECONDS, plus the time that
# writing out telemetry may take, which the platform spec's Telemetry export states.
# Type: whole number of seconds from 0 to 300. Optional, default 10.
SHUTDOWN_DRAIN_SECONDS=10

# The connection the API serves with, as the role app (DATA-12). bootstrap sets the app role's
# password from it, and the sqlx query macros check queries against it while compiling.
# Type: PostgreSQL URL with a user, a password, a host and a database, and a port unless it is
# 5432. Its only allowed query parameters are sslmode, sslrootcert, sslcert, sslkey and
# application_name. The libpq variables PGPORT, PGSSLMODE, PGSSLROOTCERT, PGSSLCERT, PGSSLKEY,
# PGAPPNAME and PGOPTIONS must be unset, even to an empty value. Required by serve and
# bootstrap, no default.
DATABASE_URL=postgres://app:__APP_PASSWORD__@127.0.0.1:5432/api

# The most connections the API's pool opens.
# Type: whole number from 1 to 1000. Optional, default 10.
DATABASE_MAX_CONNECTIONS=10

# The connection migrate runs on, as the role owner (DATA-12). bootstrap sets the owner role's
# password from it.
# Type: PostgreSQL URL, as for DATABASE_URL. Required by migrate and bootstrap, no default.
DATABASE_OWNER_URL=postgres://owner:__OWNER_PASSWORD__@127.0.0.1:5432/api

# An administrator's connection to the database, which bootstrap uses to create the roles.
# Type: PostgreSQL URL, as for DATABASE_URL. Required by bootstrap, no default.
DATABASE_ADMIN_URL=postgres://postgres:__ADMIN_PASSWORD__@127.0.0.1:5432/api

# The administrator password of the Postgres that Compose runs. Read by Compose, not by the API.
# Type: password, the same as the one in DATABASE_ADMIN_URL. Required by Compose, no default.
POSTGRES_PASSWORD=__ADMIN_PASSWORD__
