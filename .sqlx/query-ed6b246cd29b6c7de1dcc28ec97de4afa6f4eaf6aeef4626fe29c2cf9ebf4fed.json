  "query": "SELECT id, state::text AS \"state!\", created_at, ready_at, expires_at, size_bytes\n        FROM data_exports\n        WHERE user_id = $1\n            AND expires_at > now()\n            AND ($2::timestamptz IS NULL OR (created_at, id) < ($2, $3))\n        ORDER BY created_at DESC, id DESC\n        LIMIT $4",
