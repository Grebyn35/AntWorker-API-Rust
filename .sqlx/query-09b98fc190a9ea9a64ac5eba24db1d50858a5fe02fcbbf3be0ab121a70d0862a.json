  "query": "SELECT id, name, created_at\n        FROM workspaces\n        WHERE ($1::text IS NULL OR name COLLATE pg_unicode_fast ILIKE $1)\n            AND ($2::timestamptz IS NULL OR (created_at, id) < ($2, $3))\n        ORDER BY created_at DESC, id DESC\n        LIMIT $4",
