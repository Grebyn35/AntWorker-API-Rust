  "query": "SELECT id, user_id, workspace_id, type AS name, permission, payload, traceparent,\n            position AS \"position!\",\n            extract(epoch FROM clock_timestamp() - created_at)::float8 AS \"lag!\"\n        FROM events\n        WHERE position > $1 AND position <= $2\n        ORDER BY position\n        LIMIT $3",
