  "query": "SELECT id, email, role::text AS \"role!\", expires_at, created_at, updated_at\n        FROM invitations\n        WHERE workspace_id = $1 AND ($2::timestamptz IS NULL OR (created_at, id) < ($2, $3))\n        ORDER BY created_at DESC, id DESC\n        LIMIT $4",
