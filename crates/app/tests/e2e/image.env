# The settings of the image run alone, outside a deployment, which `serve` requires and none of
# its runs varies: the end-to-end tests' (image.rs), which CI runs on every push, and the replica that
# `just load-test` measures (crates/xtask/src/load/replica.rs). Each adds the databases' settings,
# its HMAC key and its own. A setting that `serve` comes to require goes here, so the image's tests
# fail until it does, and the load test's replica takes it with them.

ENVIRONMENT=production

# No run of the image alone sends email, so email is off, which `serve` requires a deployment to
# say (PLATFORM-024); PLATFORM-021's test sends it from a deployment.
EMAIL=off

# No run of the image alone stores a file, so the bucket's and the scanner's addresses name no
# host (RFC 6761): their clients reach them only when asked (PLATFORM-076, PLATFORM-077).
S3_ENDPOINT=https://bucket.invalid
S3_REGION=us-east-1
S3_BUCKET=files
S3_ACCESS_KEY_ID=image
S3_SECRET_ACCESS_KEY=image-secret
CLAMD_ADDRESS=scanner.invalid:3310
