//! The sample item's domain types (D25), and what its routes answer.

use std::borrow::Cow;

use platform::types::{Invalid, Timestamp, Version, WorkspaceId, one_line};
use serde::{Deserialize, Serialize};
use utoipa::{
    PartialSchema, ToSchema,
    openapi::{ObjectBuilder, RefOr, Schema, Type},
};

/// The most characters a sample item's name has (SAMPLE_ITEMS-002).
const NAME_MAX_CHARS: usize = 255;

/// A sample item's name: one line of text of 1 to 255 characters, normalized as `one_line` says
/// (SAMPLE_ITEMS-002). A name is personal data, so `Debug` doesn't show it (OBS-04). `Deserialize`
/// only reads back a stored result that an idempotency key replays (PLATFORM-036), which held a
/// parsed name.
#[derive(Clone, PartialEq, Eq, Serialize, Deserialize)]
#[serde(transparent)]
pub(crate) struct SampleItemName(String);

impl std::fmt::Debug for SampleItemName {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.write_str("SampleItemName([redacted])")
    }
}

impl SampleItemName {
    /// The name in `value`, normalized, or why it isn't one.
    pub(crate) fn parse(value: &str) -> Result<Self, Invalid> {
        one_line(
            value,
            NAME_MAX_CHARS,
            "Enter a name.",
            "A sample item's name has at most 255 characters.",
        )
        .map(Self)
    }

    /// A name the database holds, which was normalized when it was stored.
    pub(super) fn from_stored(name: String) -> Self {
        Self(name)
    }

    /// The normalized name.
    pub(crate) fn as_str(&self) -> &str {
        &self.0
    }
}

impl PartialSchema for SampleItemName {
    fn schema() -> RefOr<Schema> {
        ObjectBuilder::new()
            .schema_type(Type::String)
            .min_length(Some(1))
            .max_length(Some(NAME_MAX_CHARS))
            .into()
    }
}

impl ToSchema for SampleItemName {
    fn name() -> Cow<'static, str> {
        Cow::Borrowed("SampleItemName")
    }
}

/// A sample item that a member creates (SAMPLE_ITEMS-001).
#[derive(Clone, Debug, PartialEq, Eq)]
pub(crate) struct NewSampleItem {
    /// Its name.
    pub(crate) name: SampleItemName,
}

/// What renaming a sample item takes (SAMPLE_ITEMS-005).
#[derive(Clone, Debug, PartialEq, Eq)]
pub(crate) struct Rename {
    /// The new name.
    pub(crate) name: SampleItemName,
}

/// A sample item, as its routes answer it (SAMPLE_ITEMS-001, SAMPLE_ITEMS-003).
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, ToSchema)]
pub(crate) struct SampleItem {
    /// The sample item's ID.
    pub(crate) id: uuid::Uuid,
    /// Its name.
    pub(crate) name: SampleItemName,
    /// When it was created.
    pub(crate) created_at: Timestamp,
    /// When it last changed.
    pub(crate) updated_at: Timestamp,
}

/// A sample item as it now stands, with the version its `ETag` names (PLATFORM-071), which a create
/// with an idempotency key stores as its result (PLATFORM-036).
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
pub(crate) struct Current {
    /// The sample item.
    pub(crate) sample_item: SampleItem,
    /// Its row's version.
    pub(crate) version: Version,
}

/// A sample item of a workspace whose only member is the user, as their export holds it (D40).
#[derive(Debug, Serialize)]
pub(super) struct ExportedSampleItem {
    pub(super) id: uuid::Uuid,
    pub(super) workspace_id: WorkspaceId,
    pub(super) name: SampleItemName,
    pub(super) created_at: Timestamp,
    pub(super) updated_at: Timestamp,
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn sample_items_002_a_name_is_trimmed_collapsed_and_normalized() {
        let name = SampleItemName::parse("  Blue \t\n  one  ").unwrap();
        assert_eq!(name.as_str(), "Blue one");
        // "e" followed by a combining acute accent becomes one character in form C.
        let composed = SampleItemName::parse("Caf\u{65}\u{301}").unwrap();
        assert_eq!(composed.as_str(), "Caf\u{e9}");
    }

    #[test]
    fn sample_items_002_a_name_has_1_to_255_characters() {
        assert_eq!(SampleItemName::parse(" \t ").unwrap_err().code, "required");
        assert!(SampleItemName::parse(&"é".repeat(255)).is_ok());
        assert_eq!(
            SampleItemName::parse(&"a".repeat(256)).unwrap_err().code,
            "too_long"
        );
    }
}
