//! The audit actions `sample_items` records, and the kind of resource they happen to (ARCH-03, the
//! audit spec's "The action catalog").
#![expect(
    clippy::disallowed_methods,
    reason = "a module declares its audit actions and resources here (the audit spec)"
)]

use crate::modules::{
    access::SampleItemsRead,
    audit::{Action, Catalogued, Resource},
};

/// A sample item was created (SAMPLE_ITEMS-001).
pub(super) const SAMPLE_ITEM_CREATED: Action = Action::new(
    "sample_item.created",
    "A member created a sample item.",
    &[SAMPLE_ITEM],
)
.in_workspace_log::<SampleItemsRead>();
/// A sample item was renamed (SAMPLE_ITEMS-005).
pub(super) const SAMPLE_ITEM_RENAMED: Action = Action::new(
    "sample_item.renamed",
    "A member renamed a sample item.",
    &[SAMPLE_ITEM],
)
.in_workspace_log::<SampleItemsRead>();
/// A sample item was deleted (SAMPLE_ITEMS-006).
pub(super) const SAMPLE_ITEM_DELETED: Action = Action::new(
    "sample_item.deleted",
    "A member deleted a sample item.",
    &[SAMPLE_ITEM],
)
.in_workspace_log::<SampleItemsRead>();

/// A sample item.
pub(super) const SAMPLE_ITEM: Resource = Resource::new("sample_item");

/// Every action `sample_items` records, which the action catalog lists (AUDIT-012).
pub(crate) const ACTIONS: &[&dyn Catalogued] = &[
    &SAMPLE_ITEM_CREATED,
    &SAMPLE_ITEM_RENAMED,
    &SAMPLE_ITEM_DELETED,
];
