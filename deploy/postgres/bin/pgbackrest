#!/usr/bin/env bash
# Runs pgBackRest with the backup bucket's credentials and the backups' encryption passphrase.
# It reads them from the secret files that Compose mounts, so they stand in the environment of
# pgBackRest's process alone, and not in the container's, which `docker inspect` shows. It comes
# before pgBackRest itself in PATH, so every run goes through it: the archiving of the write-ahead
# log, the backups and the restores.
#
# Postgres's archive_command runs `pgbackrest --stanza=db archive-push %p`, the form pgBackRest
# checks for. For that command, this records when an archive last succeeded and when one last
# failed, as the times of two files in the status directory, which the collector reads for the
# alert on archiving that fails (OBS-14). Postgres keeps a segment, and retries it, until the
# command exits 0.
#
# During a restore's replay, Postgres's restore_command runs `pgbackrest --stanza=db archive-get`.
# Postgres takes an exit from 1 to 125 for a segment that the archive doesn't hold, which ends the
# replay there, as the archive's end, and one above 125 for an error that ends the recovery with
# its start (PostgreSQL's RestoreArchivedFile). pgBackRest exits 1 for a segment that the bucket
# doesn't hold, and its error's code for one it can't fetch, such as 42 for a segment it can't
# read, or another for a bucket that doesn't answer. So this exits 255 for every error, and a
# replay that can't fetch a segment fails the restore, rather than ending short of what the
# bucket holds (OPS-15).
#
# For `backup`, whose end expires what the retention lets go, and for `expire`, this gives
# pgBackRest the retention that /usr/local/lib/pgbackrest/retention.jq reads from the bucket's
# info: BACKUP_RETENTION_DAYS, raised to keep each full backup that a restore started from until a
# backup taken after the restore is that old, so a restore never shortens the reach (OPS-15). A
# backup whose retention it can't read expires nothing, and the next one does.
set -euo pipefail

secrets=/run/secrets
status=/var/lib/backup-status
PGBACKREST_REPO1_S3_KEY=$(< "$secrets/backup_s3_key")
PGBACKREST_REPO1_S3_KEY_SECRET=$(< "$secrets/backup_s3_key_secret")
PGBACKREST_REPO1_CIPHER_PASS=$(< "$secrets/backup_cipher_pass")
export PGBACKREST_REPO1_S3_KEY PGBACKREST_REPO1_S3_KEY_SECRET PGBACKREST_REPO1_CIPHER_PASS

case " $* " in
    *" archive-push "*)
        if /usr/bin/pgbackrest "$@"; then
            touch "$status/archived"
        else
            code=$?
            touch "$status/archive-failed"
            exit "$code"
        fi
        ;;
    *" archive-get "*)
        code=0
        /usr/bin/pgbackrest "$@" || code=$?
        case $code in
            0 | 1) exit "$code" ;;
            *) exit 255 ;;
        esac
        ;;
    *" backup "* | *" expire "*)
        days=${PGBACKREST_REPO1_RETENTION_FULL:?the retention in days, from BACKUP_RETENTION_DAYS}
        if computed=$(/usr/bin/pgbackrest --stanza=db info --output=json |
            jq -r --argjson days "$days" --argjson now "$(date +%s)" -f /usr/local/lib/pgbackrest/retention.jq); then
            retention=${computed%%$'\n'*}
            tail -n +2 <<< "$computed" | while read -r full restored; do
                printf '%s\n' "keeping the full backup $full, which the restore of $(date -u -d "@$restored" '+%Y-%m-%d %H:%M:%S+00') started from, until a backup taken after that restore is $days days old" >&2
            done
            exec /usr/bin/pgbackrest "$@" --repo1-retention-full="$retention"
        fi
        case " $* " in
            *" backup "*)
                printf '%s\n' "couldn't read the retention that keeps the backups restores started from, with the error above, so this backup expires nothing; the next one does" >&2
                exec /usr/bin/pgbackrest "$@" --no-expire-auto
                ;;
            *)
                printf '%s\n' "couldn't read the retention that keeps the backups restores started from, with the error above, so nothing expires" >&2
                exit 1
                ;;
        esac
        ;;
    *) exec /usr/bin/pgbackrest "$@" ;;
esac
