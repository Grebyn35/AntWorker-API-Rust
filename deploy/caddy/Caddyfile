# Caddy, the reference deployment's proxy (D45): it terminates TLS for every site, with
# certificates it obtains through ACME, and passes each request on. deploy.sh writes the sites the
# deployment serves, and the API's replicas, into state/, which Caddy sees at /etc/caddy-state,
# and reloads Caddy when they change. docs/operations/deploy.md describes the deployment.
{
	# Caddy's own log, which `just logs` shows, without the line its health checks write for each
	# check that fails: the replicas of the color that isn't live fail every check, by design
	# (sites/api.caddy), and a deploy reads which replicas are ready from Caddy's metrics.
	log default {
		exclude http.handlers.reverse_proxy.health_checker.active
	}
	# The authority that issues the certificates of the addresses: Let's Encrypt, and no other.
	# Caddy issues those of names that no public authority certifies, such as one under
	# `localhost`, itself.
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	# The key of each certificate that Caddy obtains: an elliptic curve key on P-256 (OPS-17).
	key_type p256
	servers {
		# The addresses whose X-Forwarded-For Caddy keeps, such as a content delivery network in
		# front of the server. From any other client, Caddy replaces the header with the
		# connection's address (SEC-13).
		trusted_proxies static {$TRUSTED_PROXIES}
		timeouts {
			read_header 10s
		}
	}
}

# The TLS that each site takes (OPS-17): versions 1.2 and 1.3, and, for 1.2, the cipher suites
# that agree on a key by an ephemeral elliptic curve exchange and encrypt with authentication.
# TLS 1.3 has only such suites, which no setting chooses. They are Caddy's defaults, named here so
# that an update of Caddy changes none of them unseen.
(tls) {
	tls {
		protocols tls1.2 tls1.3
		ciphers TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256
	}
}

import /etc/caddy-state/sites/*.caddy

# A request that names neither of the deployment's addresses, such as one for the server's own,
# gets no answer: Caddy aborts it, where it would answer an HTTPS request for a host that no site
# names with an empty 200, and a plain one with a redirect to HTTPS (SEC-14). Plain HTTP at
# Grafana's address still gets that redirect, which Caddy matches by the address's name before
# these (OPS-17). The second block imports no TLS of its own: Caddy completes no handshake that
# names neither address, or no name, and answers each with an alert, so the block gets only a
# request whose handshake named one of the addresses, under that address's TLS, and whose Host
# names another.
http:// {
	abort
}
https:// {
	abort
}
