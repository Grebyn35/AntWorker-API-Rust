# The API's address. Caddy sends each request to a replica that its own health checks find ready
# (OPS-05), and tries another when a replica refuses the connection. A replica that isn't running
# fails its check, so the replicas of the color that isn't live get no request (D45). While no
# replica can answer, Caddy answers itself, with the API's problem (D53).
{$API_ADDRESS} {
	import tls
	# HTTP Strict Transport Security: browsers reach the API over HTTPS only (SEC-12, OPS-17).
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	# The four headers that the API sets on each response that its router answers (SEC-12), on a
	# response that lacks one: what a replica's own HTTP server answers a request that it
	# refuses before the router, such as one with more headers than it takes, carries none.
	header ?X-Content-Type-Options nosniff
	header ?Referrer-Policy no-referrer
	header ?Cache-Control no-store
	header ?Content-Security-Policy "default-src 'none'; base-uri 'none'; frame-ancestors 'none'"
	header -Server

	# A span for each request but the health probes (OBS-15), which the API's server span is a
	# child of (OBS-06), exported to the collector when the deployment has telemetry
	# (deploy/compose.yaml). The collector keeps only its attributes that hold no personal data
	# (OBS-04). The matcher names the probes, which the API answers before its stack: a GET or a
	# HEAD of /health/live or /health/ready. It reads the URI as the request gave it, since
	# Caddy's `path` also takes a path in another case, and one that cleans or decodes to a
	# probe's, each of which the API answers as a path that no route serves.
	@traced {
		not {
			method GET HEAD
			expression `{http.request.uri}.matches("^/health/(live|ready)([?].*)?$")`
		}
	}
	tracing @traced {
		span proxy
	}

	# A line for each request that Caddy answers itself, which the collector reads: the API logs
	# every request that a replica answers, once (OBS-03), so every other request skips the log.
	# The line keeps no field that holds personal data (OBS-04).
	log {
		output file /var/log/caddy/access.log {
			mode 0644
			roll_size 10MiB
			roll_keep 2
		}
		format filter {
			wrap json
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers delete
			request>uri delete
			request>tls delete
			resp_headers delete
			user_id delete
		}
	}
	log_skip

	reverse_proxy {
		# The replicas of both colors, which deploy.sh writes.
		import /etc/caddy-state/upstreams
		lb_policy round_robin
		# A replica that refuses the connection is tried no more for this request, and another
		# is, twice at most; with no replica that its health checks find ready, the request fails
		# within half a second.
		lb_retries 2
		lb_try_interval 250ms
		# A replica that starts to drain answers 503 here, and Caddy stops sending it requests
		# within the interval and the timeout, while the replica keeps serving for its shutdown
		# delay, which deploy/compose.yaml sets longer (OPS-06).
		health_uri /health/ready
		health_interval 2s
		health_timeout 1s
		health_passes 1
		health_fails 1
	}

	# No replica answered, such as while a restore runs: the API's 503 problem, whose trace ID
	# leads to this request's span, marked as an error, and its log line (OPS-05, D10). Its code
	# and title are platform::errors::RequestError::Unavailable's, and its headers those the API
	# sets on every response (SEC-12) and on every response but the probes (API-16). A probe gets
	# a bare 503, as the API answers probes (API-07).
	handle_errors 502 503 504 {
		header Strict-Transport-Security "max-age=31536000; includeSubDomains"
		header X-Content-Type-Options nosniff
		header Referrer-Policy no-referrer
		header Cache-Control no-store
		header Content-Security-Policy "default-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		header -Server
		@probe {
			method GET HEAD
			expression `{http.request.uri}.matches("^/health/(live|ready)([?].*)?$")`
		}
		handle @probe {
			respond 503
		}
		handle {
			vars log_skip false
			# The line names its service's version, Caddy's, which its image sets (OBS-02).
			log_append service.version {env.CADDY_VERSION}
			tracing {
				span "no replica answered"
			}
			header Server-Timing "trace;desc=00-{http.vars.trace_id}-{http.vars.span_id}-01"
			header Content-Type application/problem+json
			header Retry-After 5
			respond `{"type":"/problems/request.unavailable","title":"No replica can answer","status":503,"code":"request.unavailable","trace_id":"{http.vars.trace_id}"}` 503
		}
	}
}

# Plain HTTP at the API's address gets no answer: Caddy closes the connection, so a client that
# sends its requests unencrypted fails at its first, where a redirect to HTTPS would let it go on
# sending each request, with its credentials, in plain text first (OPS-17). Before the site,
# Caddy still answers its certificate authority's challenge, while it obtains a certificate, and
# its own server refuses a request that it can't read. A site of its own, since one block that
# named both addresses would take the name out of Caddy's certificates.
http://{$API_ADDRESS} {
	abort
}
