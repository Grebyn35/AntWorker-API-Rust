# The API's address. Caddy sends each request to a replica that its own health checks find ready
# (OPS-05), and tries another when a replica refuses the connection. A replica that isn't running
# fails its check, so the replicas of the color that isn't live get no request (D45).
{$API_ADDRESS} {
	# HTTP Strict Transport Security: browsers reach the API over HTTPS only (SEC-11, OPS-20).
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header -Server

	reverse_proxy {
		# The replicas of both colors, which deploy.sh writes.
		import /etc/caddy-state/upstreams
		lb_policy round_robin
		lb_try_duration 5s
		lb_try_interval 250ms
		# A replica that starts to drain answers 503 here, and Caddy stops sending it requests
		# within the interval and the timeout, 3 seconds, while the replica keeps serving for its
		# shutdown delay of 5 (OPS-06).
		health_uri /health/ready
		health_interval 2s
		health_timeout 1s
		health_passes 1
		health_fails 1
	}
}
