{
  "uid": "api-platform",
  "title": "API platform",
  "description": "The health of each instance's mechanisms: its database connection, its panics and the errors it ignored.",
  "tags": [
    "api"
  ],
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "API overview",
      "type": "link",
      "url": "/d/api-overview",
      "keepTime": true,
      "targetBlank": false,
      "icon": "dashboard",
      "tags": [],
      "asDropdown": false,
      "includeVars": false,
      "tooltip": ""
    }
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "Can each instance reach its database?",
      "description": "1 while the instance's own database connection answers its checks; 0 otherwise.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "platform_database_reachable",
          "legendFormat": "{{instance}} {{db_namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Did anything panic?",
      "description": "Panics in the last 5 minutes, by instance. Every panic is a bug: its ERROR log line holds its message and location.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (increase(platform_panics_total[5m]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Which errors were ignored, and why?",
      "description": "Errors ignored on purpose in the last 5 minutes, by the name of the failure. Each has a WARN log line with its cause.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (error_type) (increase(platform_errors_ignored_total[5m]))",
          "legendFormat": "{{error_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    }
  ]
}
