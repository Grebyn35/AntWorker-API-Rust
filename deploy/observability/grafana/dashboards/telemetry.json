{
  "uid": "api-telemetry",
  "title": "Telemetry pipeline",
  "description": "Whether the API's spans, log records and metrics reach their stores: what the API failed to export, and what the collector refused, failed to pass on or decided too early.",
  "tags": [
    "api"
  ],
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "API overview",
      "type": "link",
      "url": "/d/api-overview",
      "keepTime": true,
      "targetBlank": false,
      "icon": "dashboard",
      "tags": [],
      "asDropdown": false,
      "includeVars": false,
      "tooltip": ""
    }
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "Is the API failing to export telemetry?",
      "description": "Items whose export failed in the last 5 minutes, by signal, reason and instance.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance, error_type) (increase(otel_sdk_exporter_span_exported_total{error_type!=\"\"}[5m]))",
          "legendFormat": "spans: {{error_type}} on {{instance}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance, error_type) (increase(otel_sdk_exporter_log_exported_total{error_type!=\"\"}[5m]))",
          "legendFormat": "log records: {{error_type}} on {{instance}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance, error_type) (increase(otel_sdk_exporter_metric_data_point_exported_total{error_type!=\"\"}[5m]))",
          "legendFormat": "metric data points: {{error_type}} on {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "How much telemetry does the API export?",
      "description": "Items exported per second, by signal.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(otel_sdk_exporter_span_exported_total{error_type=\"\"}[$__rate_interval]))",
          "legendFormat": "spans"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(otel_sdk_exporter_log_exported_total{error_type=\"\"}[$__rate_interval]))",
          "legendFormat": "log records"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(otel_sdk_exporter_metric_data_point_exported_total{error_type=\"\"}[$__rate_interval]))",
          "legendFormat": "metric data points"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Is the collector refusing telemetry?",
      "description": "Items per second that the collector refused, such as when its memory limit is reached.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(otelcol_receiver_refused_spans[$__rate_interval]))",
          "legendFormat": "spans"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(otelcol_receiver_refused_log_records[$__rate_interval]))",
          "legendFormat": "log records"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(otelcol_receiver_refused_metric_points[$__rate_interval]))",
          "legendFormat": "metric points"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Is the collector failing to pass telemetry on?",
      "description": "Items per second that the collector failed to send to Tempo, Loki or Prometheus.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(otelcol_exporter_send_failed_spans[$__rate_interval]))",
          "legendFormat": "spans"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(otelcol_exporter_send_failed_log_records[$__rate_interval]))",
          "legendFormat": "log records"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(otelcol_exporter_send_failed_metric_points[$__rate_interval]))",
          "legendFormat": "metric points"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Is tail sampling dropping traces before it decides them?",
      "description": "Traces per second dropped because the collector held too many undecided, and the traces it holds.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(otelcol_processor_tail_sampling_sampling_trace_dropped_too_early[$__rate_interval]))",
          "legendFormat": "dropped early"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(otelcol_processor_tail_sampling_sampling_traces_on_memory)",
          "legendFormat": "held"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "type": "timeseries",
      "title": "Which sampling policies keep traces?",
      "description": "Traces per second that each policy keeps. A trace that several policies keep counts for each.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (policy) (rate(otelcol_processor_tail_sampling_count_traces_sampled{sampled=\"true\"}[$__rate_interval]))",
          "legendFormat": "{{policy}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    },
    {
      "type": "timeseries",
      "title": "Can Prometheus reach every service of the stack?",
      "description": "1 while Prometheus scrapes the service, 0 otherwise.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      }
    }
  ]
}
