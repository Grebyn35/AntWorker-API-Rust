# The reference deployment's settings (OPS-02). `just server-setup` writes them to settings.env in
# the deployment's directory on the server: it asks for each setting that the choices need, with
# the comment above it, and keeps the rest of this file's text; docs/operations/deploy.md says how.
# Compose reads settings.env, and deploy.sh reads it too. A value is written as it is, without
# quotes. The secrets go in files of secrets/ instead, never in this file (SEC-01). A setting's
# Type line says what values it takes, and with `with NAME=value`, the choice it applies with,
# which comes before it.

# The release to deploy: the registry's name of the API's image, without a tag, which the Postgres
# image's name extends with -postgres, and the address of the repository whose CI signs them
# (OPS-14).
# Type: image name, and https URL. Required, no default.
IMAGE_REPOSITORY=ghcr.io/owner/name
SOURCE=https://github.com/owner/name

# The API's address, a domain name whose DNS records point to the server, such as
# api.example.com. Caddy obtains its certificate through ACME and serves HTTPS on it (OPS-20).
# Type: domain name. Required, no default.
API_ADDRESS=

# The addresses whose X-Forwarded-For Caddy keeps, such as a content delivery network in front of
# the server. From any other client, Caddy replaces the header with the connection's address.
# Type: IP addresses and CIDR ranges, separated by spaces. Optional, default none.
TRUSTED_PROXIES=

# How many replicas of the API serve. A deploy runs twice as many while it switches colors
# (OPS-21).
# Type: whole number from 1 to 20. Optional, default 2.
API_REPLICAS=2

# The CPUs and the memory each replica may use. The load test measures a replica under the
# defaults (OPS-18).
# Type: number of CPUs, such as 1 or 0.5, and memory, such as 512M or 1G. Optional, defaults 1
# and 512M.
API_CPUS=1
API_MEMORY=512M

# Where the database runs: bundled, the deployment's own Postgres, with its backups (OPS-17), or
# managed, a provider's Postgres, which provides point-in-time recovery of its own. With managed,
# the operator writes the three database URLs in secrets/ (docs/operations/deploy.md).
# Type: bundled or managed. Optional, default bundled.
DATABASE=bundled

# The most connections the database accepts: the bundled Postgres's max_connections, or a managed
# Postgres's limit. A deploy refuses replicas whose connections wouldn't fit (OPS-21).
# Type: whole number from 20 to 10000. Optional, default 100.
POSTGRES_MAX_CONNECTIONS=100

# Where telemetry goes (D42): self-hosted, to the observability stack on the server, with Grafana
# at GRAFANA_ADDRESS; managed, through the collector to a managed backend that accepts the
# OpenTelemetry Protocol (OTLP), such as Grafana Cloud; or off, nowhere but the containers'
# output.
# Type: self-hosted, managed or off. Optional, default self-hosted.
TELEMETRY=self-hosted

# Grafana's address, such as grafana.example.com, when TELEMETRY is self-hosted (D42).
# Type: domain name. Required with TELEMETRY=self-hosted, no default.
GRAFANA_ADDRESS=

# The managed backend's OTLP endpoint over HTTPS, and the user the collector signs in as, with
# the token in the secret file managed_otlp_token. A backend whose certificate a private
# authority signed is trusted through that authority's certificate in certs/managed-otlp-ca.crt
# of the deployment's directory. docs/operations/observability.md describes the managed path.
# Type: https URL, and user. Required with TELEMETRY=managed, no default.
MANAGED_OTLP_ENDPOINT=
MANAGED_OTLP_USER=

# The managed backend's Grafana, such as https://<stack>.grafana.net for Grafana Cloud, into which
# each deploy imports the release's dashboards and alert rules, signed in with the token in the
# secret file managed_grafana_token. A Grafana whose certificate a private authority signed is
# trusted through that authority's certificate in certs/managed-grafana-ca.crt. Empty with a
# backend that has no Grafana, whose own tools then hold the dashboards and the alerts, and every
# deploy warns that nothing imports them. docs/operations/observability.md describes the import.
# Type: https URL. Optional with TELEMETRY=managed, default empty.
MANAGED_GRAFANA_URL=

# The bucket that the bundled Postgres's backups go to, off the server, through the S3 protocol
# over HTTPS (OPS-17, OPS-20): its endpoint's host name, its port, its region, its name, and
# whether its requests name the bucket in the host name or in the path. The bucket's key pair
# and the backups' passphrase are secret files. Its certificate is checked against the operating
# system's certificate authorities, or, for a bucket of the operator's own, against the authority
# whose certificate is in certs/backup-ca.crt of the deployment's directory.
# Type: host name or IP address, port, region, bucket name, and host or path. Required with
# DATABASE=bundled, except the port, default 443, and the style, default host.
BACKUP_S3_ENDPOINT=
BACKUP_S3_PORT=443
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_URI_STYLE=host

# How many days back a restore reaches: the bucket keeps the backups and the log that reach that
# far, and lets older ones go (OPS-17).
# Type: whole number from 1 to 3650. Optional with DATABASE=bundled, default 28.
BACKUP_RETENTION_DAYS=28

# The hour of the day, in UTC, at which the daily base backup starts.
# Type: whole number from 0 to 23. Optional with DATABASE=bundled, default 3.
BACKUP_HOUR=3

# The API's own settings that a deployment chooses, which .env.example describes. The deployment
# sets the others itself.
LOG_LEVEL=info
MAX_CONCURRENT_REQUESTS=100
DATABASE_MAX_CONNECTIONS=10
